package com.jaeho.backend.service;

import org.springframework.stereotype.Service;

import com.jaeho.backend.dto.ProductRequest;

@Service
public class ProductService {
	
	public String getProduct(int id) {
        return id + "번 상품입니다.";
    }

    public String registerProduct(ProductRequest request) {
        return request.getName()
                + " 상품이 등록되었습니다. 가격: "
                + request.getPrice()
                + "원";
    }

    public String updateProduct(int id, ProductRequest request) {
        return id + "번 상품이 수정되었습니다. "
                + "이름: " + request.getName()
                + ", 가격: " + request.getPrice() + "원";
    }

    public void deleteProduct(int id) {
        System.out.println(id + "번 상품 삭제");
    }
}
