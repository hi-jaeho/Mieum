package com.jaeho.backend.controller;

import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.jaeho.backend.dto.ProductRequest;

@RequestMapping("/api/products")
@RestController
public class ProductController {
	
	@GetMapping("/{id}")
	public String getProduct(@PathVariable int id) {
		return id + "번 물품입니다.";
	}
	
	@GetMapping("/search")
	public String searchProduct(@RequestParam String name) {
		return "검색어 : " + name;
	}
	
	@PostMapping
	public String registerProduct(@RequestBody ProductRequest request) {
		return request.getName() + " 상품이 등록되었습니다. 가격 : " + request.getPrice() + "원";
	}
	
	@PutMapping("/{id}")
	public String updateProduct(@PathVariable int id,
			@RequestBody ProductRequest request) {
		return id + "번 상품이 수정되었습니다.";
	}
	
	@DeleteMapping("/{id}")
	public String deleteProduct(@PathVariable int id) {
		return id + "번 상품이 삭되었습니다.";
	}

}
